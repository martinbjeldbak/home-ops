      }
    },
    {
      "id": 31,
      "type": "bargauge",
      "title": "watch time (selected range)",
      "description": "Time the TV was on with each app or input in front. Requires watch time to be enabled in Glasshouse.",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (increase(glasshouse_watch_seconds_total[$__range])) / 3600",
          "legendFormat": "{{app}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    }
