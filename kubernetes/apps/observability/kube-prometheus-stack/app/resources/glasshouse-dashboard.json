      "title": "backlight",
      "gridPos": {
        "x": 14,
        "y": 22,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(glasshouse_picture_backlight_ratio, \"tv\", \"$1\", \"instance\", \"([^.]+?)(-lg[a-z0-9]+)?[.].*\")",
          "legendFormat": "{{tv}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 18,
      "type": "bargauge",
      "title": "remote battery",
      "gridPos": {
        "x": 19,
        "y": 22,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.15
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(glasshouse_remote_battery_ratio, \"tv\", \"$1\", \"instance\", \"([^.]+?)(-lg[a-z0-9]+)?[.].*\")",
          "legendFormat": "{{tv}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 24,
      "type": "bargauge",
      "title": "eMMC life used",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(glasshouse_emmc_life_used_ratio, \"tv\", \"$1\", \"instance\", \"([^.]+?)(-lg[a-z0-9]+)?[.].*\")",
          "legendFormat": "{{tv}} type {{type}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 25,
      "type": "bargauge",
      "title": "attention",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(1 - glasshouse_adblock_enabled, \"tv\", \"$1\", \"instance\", \"([^.]+?)(-lg[a-z0-9]+)?[.].*\")",
          "legendFormat": "{{tv}} adblock off",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "label_replace(glasshouse_emmc_pre_eol_state{state!=\"normal\"} == 1, \"tv\", \"$1\", \"instance\", \"([^.]+?)(-lg[a-z0-9]+)?[.].*\")",
          "legendFormat": "{{tv}} eMMC {{state}}",
          "instant": true
        }
      ],
      "description": "Every row reads 0 when all is well; a lit bar needs attention.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 26,
      "type": "stat",
      "title": "current app",
