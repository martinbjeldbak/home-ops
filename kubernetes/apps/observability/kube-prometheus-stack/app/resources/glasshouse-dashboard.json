      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(glasshouse_foreground_app_info, \"tv\", \"$1\", \"instance\", \"([^.]+?)(-lg[a-z0-9]+)?[.].*\")",
          "legendFormat": "{{app_name}} ({{app_id}})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
